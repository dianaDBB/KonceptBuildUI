{
  "name": "koncept-build-ui",
  "version": "1.0.0",
  "description": "KonceptBuild UI",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vue-tsc && vite build",
    "lint": "eslint ./src --fix",
    "prettier": "prettier --log-level warn . --write",
    "test:integration": "start-server-and-test start http://localhost:5173/ test:integration.local",
    "test:integration.local": "playwright test --project=integration",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e.debug": "playwright test --project=e2e --debug"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chai": "^4.3.3",
    "@types/chai-json-schema": "^1.4.10",
    "@types/chai-subset": "^1.3.6",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/tsconfig": "^0.5.0",
    "chai-exclude": "^2.1.0",
    "chai-json-schema": "^1.5.1",
    "chai-subset": "^1.6.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-config-eslint": "^14.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "prettier": "^2.7.1",
    "sass": "^1.69.0",
    "start-server-and-test": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": "20.x"
  }
}
